{
  "name": "learning/inventory-order-management",
  "description": "Native PHP layered Inventory and Order Management System",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit.integration.xml",
    "analyse": "phpstan analyse app public --level=5",
    "format-check": "phpcs --warning-severity=0",
    "quality": [
      "@test",
      "@test:integration",
      "@analyse",
      "@format-check"
    ]
  },
  "config": {
    "process-timeout": 1200
  },
  "license": [
    "proprietary"
  ]
}
